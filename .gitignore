# 本机专属配置（绝对路径 / 机器相关 GPU 策略）：只在本机生效，不进版本库。
# 共享配置是 config.toml；本文件由程序在保存时自动维护（见 utils/config.rs）。
config.local.toml
# 配置原子写留下的临时文件（正常路径会被 rename 掉，异常中断时可能残留）
*.toml.tmp

# Rust build artifacts
target/
**/*.rs.bk

# Heavyweight models and binaries
models/
tools/*
!tools/punc_runner.py
*.bin
*.gguf
*.onnx

# Test videos and temporary media
testVideo/
resources/
*.tmp

# Database & Runtime logs
*.db
*.db-journal
# WAL 模式的副产物（阶段十一把 journal_mode 切到 WAL 后才会出现）。
# `-wal` 里是尚未 checkpoint 的事务，`-shm` 是共享内存索引——
# 两者都是运行时状态，绝不该进版本库（也不该在 clone 后带过去）。
*.db-wal
*.db-shm
*.sqlite
logs/

# 源码快照压缩包（用户自行打包的发布物，不是源码）
Voice2Word_Source.zip
*.zip

# Documents & Presentations
*.pptx
*.docx
*.pdf
*开发文档*
*项目更新历程*

# Legacy Python Prototype & scripts
legacy_python/
requirements.txt
test_engines.py
ffmpeg-path.txt
watch.ps1
run_build.bat
compile_output.txt

# IDE & Editor
.idea/
.vscode/
.claude/
.claudeignore
.cursorignore
.cursorindexingignore

# Windows OS generated
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Scratch / debug leftovers
.tmp_*
.tmp-*
tmp_*
_scratch_ro/
# 随手贴的报错 / 界面截图（只用于排查，不属于项目内容）
image/

# whisper.cpp 自编译工作区（源码 + CMake 构建产物，体积大，不入库）
# 编译脚本 scripts/build_whisper_msvc_vulkan.bat 会下载源码到这里。
_whisper_build/

# 打包产物（scripts/package_release.ps1 的输出）
dist/

# 本机 release 构建的 fxc 覆盖（若用户选择写文件而非用环境变量）
.cargo/config.local.toml

# Local binaries & Python caches
*.exe
__pycache__/

# 协作者（子智能体）遗留的临时补丁脚本，绝不入库
.t[0-9]*_*.py
.tmp_*.py

# 运行期产物：批量队列与术语表（由程序维护或用户本地配置，不进版本库）
batch_queue.json
batch_queue.json.tmp
glossary.txt
# 子智能体做「隔离编译验证」时可能在仓库根留下编译产物
*.rlib
*.rmeta
